@{
    var role = Context.Session.GetString("role");
    var userName = Context.Session.GetString("name");
    var isLoggedIn = !string.IsNullOrEmpty(role);
    var isAdmin = role == "admin";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - TripVista" : "TripVista")</title>

    <link href="~/theme/assets/img/favicon.png" rel="icon">
    <link href="~/theme/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <link href="~/theme/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/theme/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/theme/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/theme/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="~/theme/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

    <link href="~/theme/assets/css/main.css" rel="stylesheet">
    <link href="~/css/tripvista-theme.css" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@ViewData["BodyClass"]">

    <header id="header" class="header d-flex align-items-center fixed-top">
        <div class="header-container container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto me-xl-0">
                <h1 class="sitename">TripVista</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    @if (isAdmin)
                    {
                        <li><a asp-controller="Admin" asp-action="AdminDashboard" class="@(IsActive("Admin", "AdminDashboard") ? "active" : "")">Dashboard</a></li>
                        <li><a asp-controller="Admin" asp-action="Packages" class="@(IsActive("Admin", "Packages") || IsActive("Admin", "CreatePackage") || IsActive("Admin", "EditPackage") ? "active" : "")">Packages</a></li>
                        <li><a asp-controller="Admin" asp-action="GetAllBookings" class="@(IsActive("Admin", "GetAllBookings" ) || IsActive("Admin","GetBookingDetails" ) ? "active" : "")">Manage Bookings</a></li>
                        <li><a asp-controller="Admin" asp-action="ManageDestinations" class="@(IsActive("Admin", "ManageDestinations") || IsActive("Admin", "CreateDestination") ? "active" : "")">Manage Destinations</a></li>
                        <li><a asp-controller="Admin" asp-action="DestinationQueue" class="@(IsActive("Admin", "DestinationQueue") ? "active" : "")">Destination Queue</a></li>
                        <li><a asp-controller="Poll" asp-action="ManagePolls" class="@(IsActive("Poll", "ManagePolls") || IsActive("Poll", "CreatePoll") || IsActive("Poll", "Results") ? "active" : "")">Manage Polls</a></li>
                        <li class="dropdown"><a href="#"><span>@userName</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                            <ul>
                                <li><a asp-controller="Account" asp-action="Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                    else if (isLoggedIn)
                    {
                        <li><a asp-controller="User" asp-action="UserDashboard" class="@(IsActive("User", "UserDashboard") ? "active" : "")">Packages</a></li>
                        <li><a asp-controller="Destination" asp-action="Destinations" class="@(IsActive("Destination", "Destinations") ? "active" : "")">Destinations</a></li>
                        <li><a asp-controller="Destination" asp-action="MySubmissions" class="@(IsActive("Destination", "MySubmissions") ? "active" : "")">My Submissions</a></li>
                        <li><a asp-controller="Booking" asp-action="Bookings" class="@(IsActive("Booking", "Bookings") ? "active" : "")">Bookings</a></li>
                        <li><a asp-controller="Poll" asp-action="Polls" class="@(IsActive("Poll", "Polls") ? "active" : "")">Polls</a></li>
                        <li><a asp-controller="Budget" asp-action="PlanTrip" class="@(IsActive("Budget", "PlanTrip") ? "active" : "")">Plan My Trip</a></li>
                        <li class="dropdown"><a href="#"><span>@userName</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                            <ul>
                                <li><a asp-controller="User" asp-action="Profile">Profile</a></li>
                                <li><a asp-controller="Account" asp-action="Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li><a asp-controller="Home" asp-action="Index" class="@(IsActive("Home", "Index") ? "active" : "")">Home</a></li>
                        <li><a asp-controller="Account" asp-action="Login" class="@(IsActive("Account", "Login") ? "active" : "")">Login</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="@(IsActive("Account", "Register") ? "active" : "")">Register</a></li>
                    }
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

            @if (isAdmin)
            {
                
            }
            else if (isLoggedIn)
            {
                
            }
            else
            {
                <a class="btn-getstarted" asp-controller="Account" asp-action="Register">Get Started</a>
            }

        </div>
    </header>

    <main class="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer position-relative dark-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center">
                        <span class="sitename">TripVista</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>Your AI-assisted travel companion.</p>
                        <p class="mt-3"><strong>Email:</strong> <span>support@tripvista.example</span></p>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Explore</h4>
                    <ul>
                        <li><i class="bi bi-chevron-right"></i> <a asp-controller="Home" asp-action="Index">Home</a></li>
                        @if (isAdmin)
                        {
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Admin" asp-action="Packages">Packages</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Admin" asp-action="DestinationQueue">Destination Queue</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Poll" asp-action="ManagePolls">Manage Polls</a></li>
                        }
                        else if (isLoggedIn)
                        {
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Destination" asp-action="Destinations">Destinations</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="User" asp-action="UserDashboard">Packages</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Booking" asp-action="Bookings">Bookings</a></li>
                        }
                        else
                        {
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Login">Login</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Account</h4>
                    <ul>
                        @if (isAdmin)
                        {
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Admin" asp-action="ManageDestinations">Manage Destinations</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Logout">Logout</a></li>
                        }
                        else if (isLoggedIn)
                        {
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="User" asp-action="Profile">Profile</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Poll" asp-action="Polls">Polls</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Budget" asp-action="PlanTrip">Plan My Trip</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Logout">Logout</a></li>
                        }
                        else
                        {
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Register">Create Account</a></li>
                        }
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h4>About TripVista</h4>
                    <p>Discover destinations, plan trips within budget, and book curated travel packages with TripVista.</p>
                </div>
            </div>
        </div>

        

    </footer>

    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <div id="preloader"></div>

    <script src="~/theme/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/theme/assets/vendor/aos/aos.js"></script>
    <script src="~/theme/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/theme/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/theme/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/theme/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
    <script src="~/theme/assets/vendor/glightbox/js/glightbox.min.js"></script>

    <script src="~/theme/assets/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
