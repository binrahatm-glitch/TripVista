@model IEnumerable<TripVista.Models.Entities.Bookings>

@{
    Layout = null;
    var userName = Context.Session.GetString("name");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>TripVista - My Bookings</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body { background-color: #f5f7fa; }
        .card { border: none; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,.06); }
        .status-badge { font-size: 0.75rem; }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="User" asp-action="UserDashboard">TripVista</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="User" asp-action="UserDashboard">Packages</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Destination" asp-action="Destinations">Destinations</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Destination" asp-action="MySubmissions">My Submissions</a></li>
                    <li class="nav-item"><a class="nav-link active fw-semibold" asp-controller="Booking" asp-action="Bookings">Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Poll" asp-action="Polls">Polls</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown">@userName</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="User" asp-action="Profile">Profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-4">

        <h3 class="fw-bold mb-4">My Bookings</h3>

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="row">
            @foreach (var booking in Model)
            {
                var tourStart = booking.Package?.TourStartDate;
                var canCancel = booking.Status == "Confirmed" && tourStart.HasValue && (tourStart.Value - DateTime.Now) >= TimeSpan.FromDays(3);

                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-semibold mb-0">@(booking.Package?.Title ?? "Package")</h5>

                                <span class="badge status-badge
                                        @(booking.Status == "Confirmed" ? "bg-success" :
                                                                            booking.Status == "Cancelled" ? "bg-danger" :
                                                                            booking.Status == "Completed" ? "bg-primary" :
                                                                            "bg-warning text-dark")">
                                    @booking.Status
                                </span>
                            </div>

                            <p class="small text-muted mb-1">Travelers: @booking.TravelersCount</p>
                            <p class="small text-muted mb-1">Booking Date: @booking.BookingDate.ToString("dd MMM yyyy")</p>

                            @if (booking.Package != null)
                            {
                                <p class="small text-muted mb-1">
                                    Tour Dates: @booking.Package.TourStartDate.ToString("dd MMM yyyy") - @booking.Package.TourEndDate.ToString("dd MMM yyyy")
                                </p>
                            }

                            @if (booking.TotalPrice != null)
                            {
                                <p class="fw-semibold text-success">PKR @booking.TotalPrice</p>
                            }

                            @if (!booking.AreTravelerDetailsSubmitted && booking.Status == "Confirmed")
                            {
                                <div class="alert alert-warning small py-2">
                                    Traveler details incomplete.
                                    <a asp-controller="Booking" asp-action="AddTravelerDetails" asp-route-bookingId="@booking.BookingId">Add now</a>
                                </div>
                            }

                            @if (booking.Status == "Confirmed")
                            {
                                @if (canCancel)
                                {
                                    <form asp-controller="Booking" asp-action="Cancel" method="post" class="mt-2">
                                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100" onclick="return confirm('Cancel this booking?');">Cancel Booking</button>
                                    </form>
                                }
                                else
                                {
                                    <p class="small text-muted mt-2 mb-0">Cancellation window has passed (must cancel at least 3 days before tour start).</p>
                                }
                            }

                            @if (booking.Status == "Cancelled" && booking.CancelledAt != null)
                            {
                                <p class="small text-muted mt-2 mb-0">Cancelled on @booking.CancelledAt.Value.ToString("dd MMM yyyy")</p>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">You have no bookings yet.</div>
        }

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
