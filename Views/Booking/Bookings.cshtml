@model IEnumerable<TripVista.Models.Entities.Bookings>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">
    <div class="container position-relative">
        <h1>My Bookings</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Bookings</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="row">
            @foreach (var booking in Model)
            {
                var tourStart = booking.Package?.TourStartDate;
                var canCancel = booking.Status == "Confirmed" && tourStart.HasValue && (tourStart.Value - DateTime.Now) >= TimeSpan.FromDays(3);

                <div class="col-lg-6 mb-4">
                    <div class="tv-card h-100">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-semibold mb-0">@(booking.Package?.Title ?? "Package")</h5>

                            <span class="tv-badge
                                    @(booking.Status == "Confirmed" ? "bg-success text-white" :
                                                                        booking.Status == "Cancelled" ? "bg-danger text-white" :
                                                                        booking.Status == "Completed" ? "bg-primary text-white" :
                                                                        "bg-warning text-dark")">
                                @booking.Status
                            </span>
                        </div>

                        <p class="small text-muted mb-1">Travelers: @booking.TravelersCount</p>
                        <p class="small text-muted mb-1">Booking Date: @booking.BookingDate.ToString("dd MMM yyyy")</p>

                        @if (booking.Package != null)
                        {
                            <p class="small text-muted mb-1">
                                Tour Dates: @booking.Package.TourStartDate.ToString("dd MMM yyyy") - @booking.Package.TourEndDate.ToString("dd MMM yyyy")
                            </p>
                        }

                        @if (booking.TotalPrice != null)
                        {
                            <p class="fw-semibold text-success">PKR @booking.TotalPrice</p>
                        }

                        @if (!booking.AreTravelerDetailsSubmitted && booking.Status == "Confirmed")
                        {
                            <div class="alert alert-warning small py-2">
                                Traveler details incomplete.
                                <a asp-controller="Booking" asp-action="AddTravelerDetails" asp-route-bookingId="@booking.BookingId">Add now</a>
                            </div>
                        }

                        @if (booking.Status == "Confirmed")
                        {
                            @if (canCancel)
                            {
                                <form asp-controller="Booking" asp-action="Cancel" method="post" class="mt-2">
                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100" onclick="return confirm('Cancel this booking?');">Cancel Booking</button>
                                </form>
                            }
                            else
                            {
                                <p class="small text-muted mt-2 mb-0">Cancellation window has passed (must cancel at least 3 days before tour start).</p>
                            }
                        }

                        @if (booking.Status == "Cancelled" && booking.CancelledAt != null)
                        {
                            <p class="small text-muted mt-2 mb-0">Cancelled on @booking.CancelledAt.Value.ToString("dd MMM yyyy")</p>
                        }

                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">You have no bookings yet.</div>
        }

    </div>
</section>
