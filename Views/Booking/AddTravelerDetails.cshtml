@model TripVista.Models.DTO.AddTravelerDetailsViewModel
@{
    ViewData["Title"] = "Traveler Details";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-7.webp")');">
    <div class="container position-relative">
        <h1>Traveler Details</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Booking" asp-action="Bookings">Bookings</a></li>
                <li class="current">Traveler Details</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <p class="text-muted">Please add details for all @Model.Travelers.Count traveler(s) on your booking for <strong>@Model.PackageTitle</strong>.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" asp-validation-summary="All"></div>
                }

                <form asp-action="AddTravelerDetails" asp-controller="Booking" method="post">
                    <input type="hidden" asp-for="BookingId" />

                    @for (int i = 0; i < Model.Travelers.Count; i++)
                    {
                        <div class="tv-card mb-3">
                            <h6>Traveler @(i + 1)</h6>
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <label class="form-label">Full Name</label>
                                    <input name="Travelers[@i].FullName" value="@Model.Travelers[i].FullName" class="form-control" required />
                                </div>
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">Age</label>
                                    <input type="number" name="Travelers[@i].Age" value="@Model.Travelers[i].Age" class="form-control" min="0" max="120" required />
                                </div>
                                <div class="col-md-3 mb-2">
                                    <label class="form-label">CNIC / Passport Number</label>
                                    <input name="Travelers[@i].CNICOrPassportNumber" value="@Model.Travelers[i].CNICOrPassportNumber" class="form-control cnic-input" required />
                                    <span class="text-danger small cnic-duplicate-msg d-none">This CNIC/Passport is already used by another traveler.</span>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <label class="form-label">Contact Number</label>
                                    <input name="Travelers[@i].ContactNumber" value="@Model.Travelers[i].ContactNumber" class="form-control" placeholder="03xxxxxxxxx" required />
                                </div>
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100 mb-4">Save Traveler Details</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const inputs = Array.from(document.querySelectorAll(".cnic-input"));

            function checkDuplicates() {
                const counts = {};
                inputs.forEach(function (input) {
                    const value = input.value.trim().toLowerCase();
                    if (value) counts[value] = (counts[value] || 0) + 1;
                });

                inputs.forEach(function (input) {
                    const value = input.value.trim().toLowerCase();
                    const isDuplicate = value && counts[value] > 1;
                    const msg = input.parentElement.querySelector(".cnic-duplicate-msg");
                    if (msg) msg.classList.toggle("d-none", !isDuplicate);
                    input.classList.toggle("is-invalid", isDuplicate);
                });
            }

            inputs.forEach(function (input) {
                input.addEventListener("input", checkDuplicates);
            });
        })();
    </script>
}
