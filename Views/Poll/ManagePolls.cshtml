@model IEnumerable<TripVista.Models.Entities.Polls>
@{
    ViewData["Title"] = "Manage Polls";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>Manage Polls</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Admin" asp-action="AdminDashboard">Admin</a></li>
                <li class="current">Manage Polls</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="section-subtitle mb-0">All Polls</h3>
            <a asp-controller="Poll" asp-action="CreatePoll" class="btn btn-primary">+ New Poll</a>
        </div>

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }

        @foreach (var poll in Model)
        {
            <div class="tv-card mb-3">
                <div class="d-flex justify-content-between">
                    <h5>@poll.Question</h5>
                    @if (poll.IsActive)
                    {
                        <span class="tv-badge bg-success text-white align-self-start">Active</span>
                    }
                    else
                    {
                        <span class="tv-badge bg-secondary text-white align-self-start">Closed</span>
                    }
                </div>

                <ul class="small text-muted">
                    @foreach (var opt in poll.Options ?? new List<TripVista.Models.Entities.PollOptions>())
                    {
                        <li>@opt.OptionText</li>
                    }
                </ul>

                <div class="d-flex gap-2">
                    <a asp-controller="Poll" asp-action="Results" asp-route-pollId="@poll.PollId" class="btn btn-outline-primary btn-sm">Results</a>

                    <form asp-controller="Poll" asp-action="ToggleActive" method="post">
                        <input type="hidden" name="pollId" value="@poll.PollId" />
                        <input type="hidden" name="isActive" value="@(!poll.IsActive)" />
                        <button type="submit" class="btn btn-outline-warning btn-sm">@(poll.IsActive ? "Close Poll" : "Reopen Poll")</button>
                    </form>

                    <form asp-controller="Poll" asp-action="DeletePoll" method="post">
                        <input type="hidden" name="pollId" value="@poll.PollId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this poll and all its votes?');">Delete</button>
                    </form>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">No polls yet.</div>
        }
    </div>
</section>
