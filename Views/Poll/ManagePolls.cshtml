@model IEnumerable<TripVista.Models.Entities.Polls>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Manage Polls</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>

    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Manage Polls</h2>
            <a asp-controller="Poll" asp-action="CreatePoll" class="btn btn-success">+ New Poll</a>
        </div>

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }

        @foreach (var poll in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h5>@poll.Question</h5>
                        @if (poll.IsActive)
                        {
                            <span class="badge bg-success align-self-start">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary align-self-start">Closed</span>
                        }
                    </div>

                    <ul class="small text-muted">
                        @foreach (var opt in poll.Options ?? new List<TripVista.Models.Entities.PollOptions>())
                        {
                            <li>@opt.OptionText</li>
                        }
                    </ul>

                    <div class="d-flex gap-2">
                        <a asp-controller="Poll" asp-action="Results" asp-route-pollId="@poll.PollId" class="btn btn-outline-primary btn-sm">Results</a>

                        <form asp-controller="Poll" asp-action="ToggleActive" method="post">
                            <input type="hidden" name="pollId" value="@poll.PollId" />
                            <input type="hidden" name="isActive" value="@(!poll.IsActive)" />
                            <button type="submit" class="btn btn-outline-warning btn-sm">@(poll.IsActive ? "Close Poll" : "Reopen Poll")</button>
                        </form>

                        <form asp-controller="Poll" asp-action="DeletePoll" method="post">
                            <input type="hidden" name="pollId" value="@poll.PollId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this poll and all its votes?');">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">No polls yet.</div>
        }

        <a asp-controller="Admin" asp-action="AdminDashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

</body>
</html>
