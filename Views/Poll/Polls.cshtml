@model IEnumerable<TripVista.Models.Entities.Polls>
@{
    Layout = null;
    var userName = Context.Session.GetString("name");
    var votedPollIds = (HashSet<Guid>)ViewBag.VotedPollIds;
    var userVotes = (Dictionary<Guid, Guid?>)ViewBag.UserVotes;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>TripVista - Polls</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f5f7fa; }
        .card { border: none; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,.06); }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="User" asp-action="UserDashboard">TripVista</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="User" asp-action="UserDashboard">Packages</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Destination" asp-action="Destinations">Destinations</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Destination" asp-action="MySubmissions">My Submissions</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Bookings">Bookings</a></li>
                    <li class="nav-item"><a class="nav-link active fw-semibold" asp-controller="Poll" asp-action="Polls">Polls</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown">@userName</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="User" asp-action="Profile">Profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        <h3 class="fw-bold mb-4">Polls</h3>

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @foreach (var poll in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@poll.Question</h5>

                    @if (votedPollIds.Contains(poll.PollId))
                    {
                        var chosenOptionId = userVotes.GetValueOrDefault(poll.PollId);
                        <p class="text-muted small">You already voted:</p>
                        <ul class="list-group">
                            @foreach (var opt in poll.Options ?? new List<TripVista.Models.Entities.PollOptions>())
                            {
                                <li class="list-group-item @(opt.PollOptionId == chosenOptionId ? "list-group-item-success fw-semibold" : "")">
                                    @opt.OptionText @(opt.PollOptionId == chosenOptionId ? " (your choice)" : "")
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <form asp-controller="Poll" asp-action="Vote" method="post">
                            <input type="hidden" name="pollId" value="@poll.PollId" />
                            @foreach (var opt in poll.Options ?? new List<TripVista.Models.Entities.PollOptions>())
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="pollOptionId" value="@opt.PollOptionId" required />
                                    <label class="form-check-label">@opt.OptionText</label>
                                </div>
                            }
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Submit Vote</button>
                        </form>
                    }
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">No active polls right now.</div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
