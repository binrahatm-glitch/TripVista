@model IEnumerable<TripVista.Models.Entities.Polls>
@{
    ViewData["Title"] = "Polls";
    var votedPollIds = (HashSet<Guid>)ViewBag.VotedPollIds;
    var userVotes = (Dictionary<Guid, Guid?>)ViewBag.UserVotes;
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-8.webp")');">
    <div class="container position-relative">
        <h1>Polls</h1>
        <p>Vote on upcoming destinations and packages.</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Polls</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @foreach (var poll in Model)
        {
            <div class="tv-card mb-3">
                <h5>@poll.Question</h5>

                @if (votedPollIds.Contains(poll.PollId))
                {
                    var chosenOptionId = userVotes.GetValueOrDefault(poll.PollId);
                    <p class="text-muted small">You already voted:</p>
                    <ul class="list-group">
                        @foreach (var opt in poll.Options ?? new List<TripVista.Models.Entities.PollOptions>())
                        {
                            <li class="list-group-item @(opt.PollOptionId == chosenOptionId ? "list-group-item-success fw-semibold" : "")">
                                @opt.OptionText @(opt.PollOptionId == chosenOptionId ? " (your choice)" : "")
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <form asp-controller="Poll" asp-action="Vote" method="post">
                        <input type="hidden" name="pollId" value="@poll.PollId" />
                        @foreach (var opt in poll.Options ?? new List<TripVista.Models.Entities.PollOptions>())
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="pollOptionId" value="@opt.PollOptionId" required />
                                <label class="form-check-label">@opt.OptionText</label>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary btn-sm mt-2">Submit Vote</button>
                    </form>
                }
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">No active polls right now.</div>
        }
    </div>
</section>
