@model TripVista.Models.Entities.Users

@{
    ViewData["Title"] = "User Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card shadow border-0 rounded-4">
                    <div class="card-body text-center p-4">

                        <!-- Avatar -->
                        <img src="@(string.IsNullOrEmpty(Model.AvatarPath)
                                                                 ? "/images/default-avatar.png"
                                                                 : Model.AvatarPath)"
                             class="rounded-circle mb-3"
                             width="120"
                             height="120"
                             alt="User Avatar" />

                        <!-- Name -->
                        <h4 class="fw-bold mb-1">
                            @Model.FullName
                        </h4>

                        <!-- Role -->
                        <span class="badge bg-primary text-capitalize mb-3">
                            @Model.Role
                        </span>

                        <hr />

                        <!-- User Info -->
                        <div class="text-start px-3">
                            <p class="mb-2">
                                <strong>Email:</strong><br />
                                <span class="text-muted">@Model.Email</span>
                            </p>

                            <p class="mb-2">
                                <strong>Joined On:</strong><br />
                                <span class="text-muted">
                                    @Model.CreatedAt.ToString("dd MMM yyyy")
                                </span>
                            </p>
                        </div>

                        <!-- Update Button -->
                        <div class="d-grid mt-4">
                            <a asp-controller="User"
                               asp-action="UpdateProfile"
                               class="btn btn-outline-primary btn-lg rounded-pill">
                                Update Profile
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
