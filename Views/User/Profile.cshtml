@model TripVista.Models.Entities.Users

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>My Profile</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Profile</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="tv-card text-center">

                    <img src="@(string.IsNullOrEmpty(Model.AvatarPath)
                                             ? Url.Content("~/theme/assets/img/person/person-m-10.webp")
                                             : Model.AvatarPath)"
                         class="rounded-circle mb-3"
                         width="120"
                         height="120"
                         style="object-fit: cover;"
                         alt="User Avatar" />

                    <h4 class="fw-bold mb-1">
                        @Model.FullName
                    </h4>

                    <span class="tv-badge text-capitalize mb-3" style="background-color: var(--accent-color); color: var(--contrast-color);">
                        @Model.Role
                    </span>

                    <hr />

                    <div class="text-start px-3">
                        <p class="mb-2">
                            <strong>Email:</strong><br />
                            <span class="text-muted">@Model.Email</span>
                        </p>

                        <p class="mb-2">
                            <strong>Joined On:</strong><br />
                            <span class="text-muted">
                                @Model.CreatedAt.ToPakistanTime().ToString("dd MMM yyyy")
                            </span>
                        </p>
                    </div>

                    <div class="d-grid mt-4">
                        <a asp-controller="User"
                           asp-action="UpdateProfile"
                           class="btn btn-outline-primary">
                            Update Profile
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>
