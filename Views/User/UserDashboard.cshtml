@model IEnumerable<TripVista.Models.Entities.Packages>

@{
    ViewData["Title"] = "My Dashboard";
    var userName = Context.Session.GetString("name");
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-8.webp")');">
    <div class="container position-relative">
        <h1>Welcome, @userName</h1>
        <p>Browse curated travel packages and book your next trip.</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Packages</li>
            </ol>
        </nav>
    </div>
</div>

<section id="travel-tours" class="travel-tours section">
    <div class="container" data-aos="fade-up">

        <div class="row">
            <div class="col-12">
                <h3 class="section-subtitle mb-4">Travel Packages</h3>
            </div>
        </div>

        <div class="row" id="package-container">
            @for (int i = 0; i < Model.Count(); i++)
            {
                var pkg = Model.ElementAt(i);

                <div class="col-lg-4 col-md-6 mb-4 package-item" style="display:@(i < 6 ? "block" : "none")">
                    <div class="tour-card">
                        <div class="tour-image">
                            @if (!string.IsNullOrEmpty(pkg.ImagePath))
                            {
                                <img src="@pkg.ImagePath" alt="@pkg.Title" class="img-fluid">
                            }
                            else
                            {
                                <img src="@Url.Content("~/theme/assets/img/travel/tour-3.webp")" alt="@pkg.Title" class="img-fluid">
                            }
                            <div class="tour-price">PKR @pkg.PricePerPerson.ToString("N0")</div>
                        </div>
                        <div class="tour-content">
                            <h4>@pkg.Title</h4>
                            <p>@(string.IsNullOrEmpty(pkg.Details) ? "Starts " + pkg.TourStartDate.ToString("dd MMM yyyy") : pkg.Details)</p>
                            <div class="tour-details">
                                <span><i class="bi bi-clock"></i> @pkg.DurationDays Days</span>
                                <span><i class="bi bi-people"></i> Up to @pkg.MaxGroupSize</span>
                            </div>
                            <a asp-controller="Packages" asp-action="ViewDetails" asp-route-id="@pkg.PackageId" class="btn btn-outline-primary">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">No packages available yet.</div>
        }

        @if (Model.Count() > 6)
        {
            <div class="text-center mt-3">
                <button id="loadMorePackages" class="btn btn-outline-primary px-4">Load More Packages</button>
            </div>
        }

    </div>
</section>

@section Scripts {
    <script>
        const packageItems = document.querySelectorAll(".package-item");
        let packageVisible = 6;

        const loadMoreBtn = document.getElementById("loadMorePackages");
        if (loadMoreBtn) {
            loadMoreBtn.addEventListener("click", function () {
                for (let i = packageVisible; i < packageVisible + 6 && i < packageItems.length; i++) {
                    packageItems[i].style.display = "block";
                }
                packageVisible += 6;

                if (packageVisible >= packageItems.length) {
                    this.style.display = "none";
                }
            });
        }
    </script>
}
