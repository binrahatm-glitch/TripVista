@model IEnumerable<TripVista.Models.Entities.Packages>

@{
    Layout = null;
    var userName = Context.Session.GetString("name");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>TripVista Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f7fa;
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,.06);
        }

        .card-img-top {
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
        }

        .package-scroll {
            gap: 1rem;
        }

        .badge-price {
            background: #198754;
        }
    </style>
</head>

<body>

    <!-- ==============================
         NAVBAR
         ============================== -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="User"
               asp-action="UserDashboard">
                TripVista
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active fw-semibold"
                           asp-controller="User"
                           asp-action="UserDashboard">
                            Packages
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Destination"
                           asp-action="Destinations">
                            Destinations
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Destination"
                           asp-action="MySubmissions">
                            My Submissions
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Booking"
                           asp-action="Bookings">
                            Bookings
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Poll"
                           asp-action="Polls">
                            Polls
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Budget"
                           asp-action="PlanTrip">
                            Plan My Trip
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">
                            @userName
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="User"
                                   asp-action="Profile">
                                    Profile
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <!-- ==============================
         MAIN CONTENT
         ============================== -->
    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold">
                Welcome, <span class="text-primary">@userName</span>
            </h3>
        </div>

        <!-- ===================================
             TRAVEL PACKAGES
             =================================== -->
        <h4 class="section-title">Travel Packages</h4>

        <div id="package-container"
             class="d-flex overflow-auto package-scroll pb-3">

            @for (int i = 0; i < Model.Count(); i++)
            {
                var pkg = Model.ElementAt(i);

                <div class="package-item"
                     style="min-width: 280px; display:@(i < 4 ? "block" : "none")">

                    <div class="card h-100">

                        @if (!string.IsNullOrEmpty(pkg.ImagePath))
                        {
                            <img src="@pkg.ImagePath"
                                 class="card-img-top"
                                 style="height:160px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white text-center py-5">
                                No Image Available
                            </div>
                        }

                        <div class="card-body">
                            <h5 class="fw-semibold">@pkg.Title</h5>

                            <div class="d-flex justify-content-between small mb-2">
                                <span class="badge badge-price">
                                    PKR @pkg.PricePerPerson
                                </span>
                                <span class="text-muted">
                                    @pkg.DurationDays Days
                                </span>
                            </div>

                            <p class="small text-muted mb-2">
                                @pkg.TourStartDate.ToString("dd MMM yyyy")
                            </p>

                            <a asp-controller="Packages"
                               asp-action="ViewDetails"
                               asp-route-id="@pkg.PackageId"
                               class="btn btn-primary btn-sm w-100">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-3">
            <button id="loadMorePackages"
                    class="btn btn-outline-primary btn-sm px-4">
                Load More Packages
            </button>
        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Load More Packages -->
    <script>
        const packageItems = document.querySelectorAll(".package-item");
        let packageVisible = 4;

        document.getElementById("loadMorePackages").addEventListener("click", function () {
            for (let i = packageVisible; i < packageVisible + 4 && i < packageItems.length; i++) {
                packageItems[i].style.display = "block";
            }
            packageVisible += 4;

            if (packageVisible >= packageItems.length) {
                this.style.display = "none";
            }
        });
    </script>

</body>
</html>
