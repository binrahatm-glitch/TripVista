@model TripVista.Models.DTO.UpdateProfileViewModel
@{
    ViewData["Title"] = "Update Profile";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>Update Profile</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="User" asp-action="Profile">Profile</a></li>
                <li class="current">Update Profile</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                @if (TempData["msg"] != null)
                {
                    <div class="alert alert-success">@TempData["msg"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <div class="tv-card mb-4">
                    <h5 class="fw-semibold mb-3">Profile Details</h5>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" asp-validation-summary="All"></div>
                    }

                    <form asp-action="UpdateProfile" asp-controller="User" method="post" enctype="multipart/form-data">

                        <div class="text-center mb-3">
                            <img src="@(string.IsNullOrEmpty(Model.AvatarPath)
                                        ? Url.Content("~/theme/assets/img/person/person-m-10.webp")
                                        : Model.AvatarPath)"
                                 class="rounded-circle mb-2"
                                 width="100"
                                 height="100"
                                 style="object-fit: cover;"
                                 alt="User Avatar" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Avatar (optional)</label>
                            <input type="file" asp-for="Avatar" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>

                <div class="tv-card">
                    <h5 class="fw-semibold mb-3">Change Password</h5>

                    <form asp-action="ChangePassword" asp-controller="User" method="post">

                        <div class="mb-3">
                            <label class="form-label">Current Password</label>
                            <input type="password" name="CurrentPassword" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="NewPassword" class="form-control" minlength="6" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmNewPassword" class="form-control" minlength="6" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-outline-primary">Change Password</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</section>
