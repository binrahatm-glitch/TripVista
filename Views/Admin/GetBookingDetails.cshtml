@model TripVista.Models.Entities.Bookings

@{
    ViewData["Title"] = "Booking Details";
}

<!-- Page Title -->

<div class="page-title dark-background"
     data-aos="fade"
     style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">

    <div class="container position-relative">
        <h1>Booking Details</h1>

        <nav class="breadcrumbs">
            <ol>
                <li>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </li>

                <li>
                    <a asp-controller="Admin" asp-action="GetAllBookings">
                        Booking Management
                    </a>
                </li>

                <li class="current">Booking Details</li>
            </ol>
        </nav>
    </div>

</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

            <div>
                <h2 class="mb-1 fw-semibold">
                    Booking Details
                </h2>

                <p class="text-muted mb-0">
                    View complete information about this booking.
                </p>
            </div>

            <div class="mt-3 mt-md-0">

                <a asp-controller="Admin"
                   asp-action="GetAllBookings"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left"></i>
                    Back to Bookings

                </a>

            </div>

        </div>


        <div class="row g-4">

            <!-- ================================= -->
            <!-- BOOKING INFORMATION -->
            <!-- ================================= -->

            <div class="col-lg-6">

                <div class="tv-card h-100">

                    <div class="d-flex align-items-center mb-4">

                        <div class="me-3">
                            <i class="bi bi-receipt fs-3"></i>
                        </div>

                        <div>
                            <h4 class="mb-0 fw-semibold">
                                Booking Information
                            </h4>

                            <small class="text-muted">
                                Booking and payment details
                            </small>
                        </div>

                    </div>


                    <div class="row g-3">

                        <!-- Booking ID -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Booking ID
                            </div>

                            <div class="fw-semibold">
                                #@Model.BookingId.ToString().Substring(0, 8).ToUpper()
                            </div>

                        </div>


                        <!-- Booking Date -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Booking Date
                            </div>

                            <div class="fw-semibold">
                                @Model.BookingDate.ToString("dd MMM yyyy")
                            </div>

                        </div>


                        <!-- Status -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Status
                            </div>

                            <span class="tv-badge
                                @(Model.Status == "Confirmed"
                                    ? "bg-success text-white"
                                    : Model.Status == "Cancelled"
                                        ? "bg-danger text-white"
                                        : Model.Status == "Completed"
                                            ? "bg-primary text-white"
                                            : "bg-warning text-dark")">

                                @Model.Status

                            </span>

                        </div>


                        <!-- Payment Status -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Payment Status
                            </div>

                            <span class="tv-badge
                                @(Model.PaymentStatus == "Paid"
                                    ? "bg-success text-white"
                                    : "bg-warning text-dark")">

                                @Model.PaymentStatus

                            </span>

                        </div>


                        <!-- Total Price -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Total Price
                            </div>

                            <div class="fw-semibold text-success">
                                PKR @(Model.TotalPrice?.ToString("N0") ?? "0")
                            </div>

                        </div>


                        <!-- Travelers Count -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Travelers Count
                            </div>

                            <div class="fw-semibold">
                                @Model.TravelersCount
                            </div>

                        </div>


                        <!-- Payment Reference -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Payment Reference
                            </div>

                            <div class="fw-semibold text-break">
                                @(Model.PaymentReference ?? "N/A")
                            </div>

                        </div>


                        <!-- Paid At -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Paid At
                            </div>

                            <div class="fw-semibold">
                                @(Model.PaidAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "N/A")
                            </div>

                        </div>


                        <!-- Traveler Details -->
                        <div class="col-12">

                            <div class="small text-muted mb-1">
                                Traveler Details
                            </div>

                            @if (Model.AreTravelerDetailsSubmitted)
                            {
                                <span class="badge bg-success">
                                    Submitted
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Not Submitted
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================= -->
            <!-- CUSTOMER INFORMATION -->
            <!-- ================================= -->

            <div class="col-lg-6">

                <div class="tv-card h-100">

                    <div class="d-flex align-items-center mb-4">

                        <div class="me-3">
                            <i class="bi bi-person-circle fs-3"></i>
                        </div>

                        <div>
                            <h4 class="mb-0 fw-semibold">
                                Customer Information
                            </h4>

                            <small class="text-muted">
                                Customer who made the booking
                            </small>
                        </div>

                    </div>


                    <div class="row g-3">



                        <!-- Full Name -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Full Name
                            </div>

                            <div class="fw-semibold">
                                @(Model.User?.FullName ?? "N/A")
                            </div>

                        </div>


                        <!-- Email -->
                        <div class="col-md-6">

                            <div class="small text-muted mb-1">
                                Email
                            </div>

                            <div class="fw-semibold text-break">
                                @(Model.User?.Email ?? "N/A")
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================= -->
            <!-- PACKAGE INFORMATION -->
            <!-- ================================= -->

            <div class="col-12">

                <div class="tv-card">

                    <div class="d-flex align-items-center mb-4">

                        <div class="me-3">
                            <i class="bi bi-map fs-3"></i>
                        </div>

                        <div>
                            <h4 class="mb-0 fw-semibold">
                                Package Information
                            </h4>

                            <small class="text-muted">
                                Tour package associated with this booking
                            </small>
                        </div>

                    </div>


                    @if (Model.Package != null)
                    {
                        <div class="row g-4">

                            <!-- Package -->
                            <div class="col-md-6 col-lg-3">

                                <div class="small text-muted mb-1">
                                    Package
                                </div>

                                <div class="fw-semibold">
                                    @Model.Package.Title
                                </div>

                            </div>


                            <!-- Region -->
                            <div class="col-md-6 col-lg-3">

                                <div class="small text-muted mb-1">
                                    Region
                                </div>

                                <div class="fw-semibold">
                                    @(Model.Package.Region ?? "N/A")
                                </div>

                            </div>


                            <!-- Tour Start -->
                            <div class="col-md-6 col-lg-3">

                                <div class="small text-muted mb-1">
                                    Tour Start Date
                                </div>

                                <div class="fw-semibold">
                                    @Model.Package.TourStartDate.ToString("dd MMM yyyy")
                                </div>

                            </div>


                            <!-- Tour End -->
                            <div class="col-md-6 col-lg-3">

                                <div class="small text-muted mb-1">
                                    Tour End Date
                                </div>

                                <div class="fw-semibold">
                                    @Model.Package.TourEndDate.ToString("dd MMM yyyy")
                                </div>

                            </div>


                            <!-- Price -->
                            <div class="col-md-6 col-lg-3">

                                <div class="small text-muted mb-1">
                                    Price Per Person
                                </div>

                                <div class="fw-semibold text-success">
                                    PKR @Model.Package.PricePerPerson.ToString("N0")
                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Package information is not available.
                        </div>
                    }

                </div>

            </div>


            <!-- ================================= -->
            <!-- TRAVELER INFORMATION -->
            <!-- ================================= -->

            <div class="col-12">

                <div class="tv-card">

                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

                        <div class="d-flex align-items-center">

                            <div class="me-3">
                                <i class="bi bi-people fs-3"></i>
                            </div>

                            <div>
                                <h4 class="mb-0 fw-semibold">
                                    Traveler Information
                                </h4>

                                <small class="text-muted">
                                    Details of all travelers in this booking
                                </small>
                            </div>

                        </div>


                        <span class="badge bg-secondary mt-2 mt-md-0">

                            @(Model.BookingTravelers?.Count ?? 0) Traveler(s)

                        </span>

                    </div>


                    @if (Model.BookingTravelers != null &&
                         Model.BookingTravelers.Any())
                    {
                        <div class="row g-3">

                            @foreach (var traveler in Model.BookingTravelers)
                            {
                                <div class="col-lg-6">

                                    <div class="border rounded p-3 h-100">

                                        <div class="d-flex align-items-center mb-3">

                                            <div class="me-3">
                                                <i class="bi bi-person fs-4"></i>
                                            </div>

                                            <div>

                                                <h5 class="mb-0 fw-semibold">
                                                    @traveler.FullName
                                                </h5>

                                                <small class="text-muted">
                                                    Traveler
                                                </small>

                                            </div>

                                        </div>


                                        <div class="row g-3">

                                            <!-- Full Name -->
                                            <div class="col-12">

                                                <div class="small text-muted mb-1">
                                                    Full Name
                                                </div>

                                                <div class="fw-semibold">
                                                    @traveler.FullName
                                                </div>

                                            </div>


                                            <!-- Age -->
                                            <div class="col-md-6">

                                                <div class="small text-muted mb-1">
                                                    Age
                                                </div>

                                                <div class="fw-semibold">
                                                    @traveler.Age
                                                </div>

                                            </div>


                                            <!-- CNIC / Passport -->
                                            <div class="col-md-6">

                                                <div class="small text-muted mb-1">
                                                    CNIC / Passport
                                                </div>

                                                <div class="fw-semibold text-break">
                                                    @traveler.CNICOrPassportNumber
                                                </div>

                                            </div>


                                            <!-- Contact -->
                                            <div class="col-12">

                                                <div class="small text-muted mb-1">
                                                    Contact Number
                                                </div>

                                                <div class="fw-semibold">
                                                    @traveler.ContactNumber
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">

                            No traveler details have been submitted
                            for this booking yet.

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</section>
