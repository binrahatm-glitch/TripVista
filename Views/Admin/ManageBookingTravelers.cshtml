@model TripVista.Models.DTO.ManageBookingTravelersViewModel
@{
    ViewData["Title"] = "Manage Travelers";
    var toRemove = Model.ExistingTravelers.Count - Model.NewCount;
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">
    <div class="container position-relative">
        <h1>Manage Travelers</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Admin" asp-action="GetAllBookings">Manage Bookings</a></li>
                <li class="current">Manage Travelers</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="tv-card mb-4">
                    <p class="text-muted mb-0">
                        Updating traveler count for <strong>@Model.PackageTitle</strong> to <strong>@Model.NewCount</strong> traveler(s).
                    </p>
                </div>

                @if (toRemove > 0)
                {
                    <div class="alert alert-warning">
                        Remove @toRemove more traveler(s) below to match the new count.
                    </div>

                    <div class="row g-3">
                        @foreach (var traveler in Model.ExistingTravelers)
                        {
                            <div class="col-md-6">
                                <div class="tv-card h-100">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@traveler.FullName</h6>
                                            <div class="small text-muted">Age: @traveler.Age</div>
                                            <div class="small text-muted">CNIC/Passport: @traveler.CNICOrPassportNumber</div>
                                            <div class="small text-muted">Contact: @traveler.ContactNumber</div>
                                        </div>

                                        <form asp-action="RemoveBookingTraveler" method="post" onsubmit="return confirm('Remove this traveler?');">
                                            <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                            <input type="hidden" name="travelerId" value="@traveler.Id" />
                                            <input type="hidden" name="newCount" value="@Model.NewCount" />
                                            <input type="hidden" name="newPrice" value="@Model.NewPrice" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (Model.AdditionalTravelers.Any())
                {
                    @if (Model.ExistingTravelers.Any())
                    {
                        <p class="text-muted">Existing traveler(s) on this booking:</p>
                        <div class="row g-3 mb-4">
                            @foreach (var traveler in Model.ExistingTravelers)
                            {
                                <div class="col-md-6">
                                    <div class="tv-card h-100">
                                        <h6 class="mb-1">@traveler.FullName</h6>
                                        <div class="small text-muted">Age: @traveler.Age</div>
                                        <div class="small text-muted">CNIC/Passport: @traveler.CNICOrPassportNumber</div>
                                        <div class="small text-muted">Contact: @traveler.ContactNumber</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <p class="text-muted">Please provide details for the @Model.AdditionalTravelers.Count new traveler(s):</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" asp-validation-summary="All"></div>
                    }

                    <form asp-action="ManageBookingTravelers" method="post">
                        <input type="hidden" asp-for="BookingId" />
                        <input type="hidden" asp-for="NewCount" />
                        <input type="hidden" asp-for="NewPrice" />

                        @for (int i = 0; i < Model.AdditionalTravelers.Count; i++)
                        {
                            <div class="tv-card mb-3">
                                <h6>New Traveler @(i + 1)</h6>
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <label class="form-label">Full Name</label>
                                        <input name="AdditionalTravelers[@i].FullName" value="@Model.AdditionalTravelers[i].FullName" class="form-control" required />
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label">Age</label>
                                        <input type="number" name="AdditionalTravelers[@i].Age" value="@Model.AdditionalTravelers[i].Age" class="form-control" min="0" max="120" required />
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label">CNIC / Passport Number</label>
                                        <input name="AdditionalTravelers[@i].CNICOrPassportNumber" value="@Model.AdditionalTravelers[i].CNICOrPassportNumber" class="form-control" required />
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label">Contact Number</label>
                                        <input name="AdditionalTravelers[@i].ContactNumber" value="@Model.AdditionalTravelers[i].ContactNumber" class="form-control" placeholder="03xxxxxxxxx" required />
                                    </div>
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary">Save Travelers</button>
                        <a asp-controller="Admin" asp-action="GetAllBookings" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        The traveler count already matches. <a asp-controller="Admin" asp-action="GetAllBookings">Back to Bookings</a>
                    </div>
                }

            </div>
        </div>
    </div>
</section>
