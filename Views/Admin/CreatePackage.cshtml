@model TripVista.Models.DTO.PackageFormViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Create Package</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>

    <div class="container mt-5 col-md-8">
        <h2 class="mb-4">Create Package</h2>

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="card p-3 mb-4 bg-light">
            <h6>Need help pricing this package?</h6>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small">Region</label>
                    <select id="estRegion" class="form-select form-select-sm">
                        <option value="Northern">Northern Areas</option>
                        <option value="Coastal">Coastal</option>
                        <option value="Urban">Urban</option>
                        <option value="Desert">Desert</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Season</label>
                    <select id="estSeason" class="form-select form-select-sm">
                        <option value="Peak">Peak</option>
                        <option value="Off-Peak">Off-Peak</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="button" id="estimateBtn" class="btn btn-outline-primary btn-sm w-100">Estimate Budget</button>
                </div>
            </div>
            <div id="estimateResult" class="small text-muted mt-2"></div>
        </div>

        <form asp-action="CreatePackage" method="post">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Details" class="form-label">Description</label>
                <textarea asp-for="Details" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="ImagePath" class="form-label">Image URL</label>
                <input asp-for="ImagePath" class="form-control" />
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="PricePerPerson" class="form-label"></label>
                    <input asp-for="PricePerPerson" type="number" step="0.01" class="form-control" id="pricePerPerson" />
                    <span asp-validation-for="PricePerPerson" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DurationDays" class="form-label"></label>
                    <input asp-for="DurationDays" type="number" class="form-control" id="durationDays" />
                    <span asp-validation-for="DurationDays" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxGroupSize" class="form-label"></label>
                    <input asp-for="MaxGroupSize" type="number" class="form-control" id="maxGroupSize" />
                    <span asp-validation-for="MaxGroupSize" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="TourStartDate" class="form-label"></label>
                    <input asp-for="TourStartDate" type="date" class="form-control" />
                    <span asp-validation-for="TourStartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TourEndDate" class="form-label"></label>
                    <input asp-for="TourEndDate" type="date" class="form-control" />
                    <span asp-validation-for="TourEndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active (visible to users)</label>
            </div>

            <div class="mb-3">
                <label class="form-label">Destinations Visited</label>
                <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                    @if (!Model.DestinationOptions.Any())
                    {
                        <p class="text-muted small mb-0">No approved destinations yet.</p>
                    }
                    @for (int i = 0; i < Model.DestinationOptions.Count; i++)
                    {
                        <div class="form-check">
                            <input type="hidden" asp-for="DestinationOptions[i].DestinationId" />
                            <input type="hidden" asp-for="DestinationOptions[i].Name" />
                            <input type="checkbox" asp-for="DestinationOptions[i].Selected" class="form-check-input" />
                            <label class="form-check-label">@Model.DestinationOptions[i].Name</label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-success">Create Package</button>
            <a asp-controller="Admin" asp-action="Packages" class="btn btn-secondary">Cancel</a>
        </form>
    </div>

    <script>
        document.getElementById("estimateBtn").addEventListener("click", async function () {
            const region = document.getElementById("estRegion").value;
            const season = document.getElementById("estSeason").value;
            const duration = parseInt(document.getElementById("durationDays").value) || 1;
            const groupSize = parseInt(document.getElementById("maxGroupSize").value) || 1;

            const params = new URLSearchParams({ region, season, durationDays: duration, groupSize });
            const res = await fetch("/Budget/EstimatePackagePrice?" + params.toString());
            if (!res.ok) return;
            const data = await res.json();

            document.getElementById("estimateResult").innerText =
                `Suggested price per person: PKR ${data.minSuggestedPrice} - PKR ${data.maxSuggestedPrice}`;
        });
    </script>

</body>
</html>
