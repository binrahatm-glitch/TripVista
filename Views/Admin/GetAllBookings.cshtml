
@model IEnumerable<TripVista.Models.Entities.Bookings>

@{
    ViewData["Title"] = "Manage Bookings";

    var bookings = Model?.ToList() ?? new List<TripVista.Models.Entities.Bookings>();

    var totalBookings = bookings.Count;
    var pendingPayment = bookings.Count(x => x.PaymentStatus == "Pending");
    var confirmedBookings = bookings.Count(x => x.Status == "Confirmed");
    var cancelledBookings = bookings.Count(x => x.Status == "Cancelled");
}

<div class="page-title dark-background"
     data-aos="fade"
     style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">
    <div class="container position-relative">
        <h1>Manage Bookings</h1>

        <nav class="breadcrumbs">
            <ol>
                <li>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="AdminDashboard">Admin</a>
                </li>
                <li class="current">Manage Bookings</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        <!-- Header -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h3 class="section-subtitle mb-1">All Bookings</h3>
                <p class="text-muted mb-0">
                    Monitor customer bookings, payments and booking status.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-outline-secondary">
                ← Dashboard
            </a>
        </div>

        <!-- Alerts -->
        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["msg"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <!-- Statistics -->
        <div class="row g-3 mb-4">

            <div class="col-6 col-xl-3">
                <div class="tv-card h-100">
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Total Bookings</small>
                                <h4 class="mb-0 mt-1">@totalBookings</h4>
                            </div>

                            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                <i class="bi bi-calendar-check text-primary fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="tv-card h-100">
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Pending Payment</small>
                                <h4 class="mb-0 mt-1">@pendingPayment</h4>
                            </div>

                            <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                <i class="bi bi-credit-card text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="tv-card h-100">
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Confirmed</small>
                                <h4 class="mb-0 mt-1">@confirmedBookings</h4>
                            </div>

                            <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                <i class="bi bi-check-circle text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="tv-card h-100">
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Cancelled</small>
                                <h4 class="mb-0 mt-1">@cancelledBookings</h4>
                            </div>

                            <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                                <i class="bi bi-x-circle text-danger fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Filters -->
        <div class="tv-card mb-4">
            <div class="p-3">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-lg-4">
                        <label for="bookingSearch" class="form-label">
                            Search
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="bookingSearch"
                                   class="form-control"
                                   placeholder="Search customer, package or booking ID...">
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-2">
                        <label for="statusFilter" class="form-label">
                            Booking Status
                        </label>

                        <select id="statusFilter" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="PendingPayment">Pending Payment</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-2">
                        <label for="paymentFilter" class="form-label">
                            Payment
                        </label>

                        <select id="paymentFilter" class="form-select">
                            <option value="">All Payments</option>
                            <option value="Pending">Pending</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <label for="travelerFilter" class="form-label">
                            Travelers
                        </label>

                        <select id="travelerFilter" class="form-select">
                            <option value="">Any</option>
                            <option value="1">1 Traveler</option>
                            <option value="2">2 Travelers</option>
                            <option value="3">3 Travelers</option>
                            <option value="4">4 Travelers</option>
                            <option value="5+">5+ Travelers</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <button type="button"
                                id="clearFilters"
                                class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Clear
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <!-- Booking Table -->
        <div class="tv-card">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 border-bottom">
                <div>
                    <strong>Booking Records</strong>
                    <span class="text-muted ms-1">
                        (<span id="visibleBookingCount">@totalBookings</span>)
                    </span>
                </div>

                <div class="text-muted small">
                    Latest bookings are shown first
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0" id="bookingsTable">

                    <thead>
                        <tr>
                            <th>Booking</th>
                            <th>Customer</th>
                            <th>Package</th>
                            <th>Travelers</th>
                            <th>Booking Date</th>
                            <th>Total Price</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var booking in bookings.OrderByDescending(x => x.BookingDate))
                        {
                            <tr class="booking-row"
                                data-status="@booking.Status"
                                data-payment="@booking.PaymentStatus"
                                data-travelers="@booking.TravelersCount">

                                <!-- Booking -->
                                <td>
                                    <div class="fw-semibold">
                                        #@booking.BookingId.ToString().Substring(0, 8).ToUpper()
                                    </div>
                                </td>

                                <!-- Customer -->
                                <td>
                                    <div class="fw-semibold">
                                        @booking.User?.FullName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(booking.User?.Email))
                                    {
                                        <small class="text-muted">
                                            @booking.User.Email
                                        </small>
                                    }
                                </td>

                                <!-- Package -->
                                <td>
                                    <div class="fw-semibold">
                                        @(booking.Package?.Title ?? "N/A")
                                    </div>
                                </td>

                                <!-- Travelers -->
                                <td>
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-people"></i>
                                        @booking.TravelersCount
                                    </span>
                                </td>

                                <!-- Date -->
                                <td>
                                    <div>
                                        @booking.BookingDate.ToPakistanTime().ToString("dd MMM yyyy")
                                    </div>

                                    <small class="text-muted">
                                        @booking.BookingDate.ToPakistanTime().ToString("hh:mm tt")
                                    </small>
                                </td>

                                <!-- Price -->
                                <td>
                                    <strong>
                                        @(booking.TotalPrice?.ToString("N2") ?? "0.00")
                                    </strong>
                                </td>

                                <!-- Payment -->
                                <td>
                                    @if (booking.PaymentStatus == "Paid")
                                    {
                                        <span class="tv-badge bg-success text-white">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Paid
                                        </span>

                                        @if (booking.PaidAt.HasValue)
                                        {
                                            <small class="d-block text-muted mt-1">
                                                @booking.PaidAt.Value.ToPakistanTime().ToString("dd MMM yyyy")
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="tv-badge bg-warning text-dark">
                                            <i class="bi bi-clock me-1"></i>
                                            Pending
                                        </span>
                                    }
                                </td>

                                <!-- Booking Status -->
                                <td>
                                    @switch (booking.Status)
                                    {
                                        case "PendingPayment":
                                            <span class="tv-badge bg-warning text-dark">
                                                Pending Payment
                                            </span>
                                            break;

                                        case "Confirmed":
                                            <span class="tv-badge bg-success text-white">
                                                Confirmed
                                            </span>
                                            break;

                                        case "Cancelled":
                                            <span class="tv-badge bg-danger text-white">
                                                Cancelled
                                            </span>
                                            break;

                                        case "Completed":
                                            <span class="tv-badge bg-primary text-white">
                                                Completed
                                            </span>
                                            break;

                                        default:
                                            <span class="tv-badge bg-secondary text-white">
                                                @booking.Status
                                            </span>
                                            break;
                                    }

                                    @if (booking.AreTravelerDetailsSubmitted)
                                    {
                                        <small class="d-block text-success mt-1">
                                            <i class="bi bi-person-check me-1"></i>
                                            Traveler details submitted
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="d-block text-muted mt-1">
                                            Traveler details pending
                                        </small>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="text-end">

                                    <div class="dropdown">
                                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            Actions
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">

                                            <li>
                                                <a asp-controller="Admin"
                                                   asp-action="GetBookingDetails"
                                                   asp-route-bookingId="@booking.BookingId"
                                                   class="dropdown-item">
                                                    <i class="bi bi-eye me-1"></i>
                                                    View Details
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Admin"
                                                   asp-action="EditBooking"
                                                   asp-route-id="@booking.BookingId">
                                                    <i class="bi bi-pencil me-2"></i>
                                                    Edit Booking
                                                </a>
                                            </li>

                                            <li><hr class="dropdown-divider"></li>

                                            @if (booking.PaymentStatus != "Paid")
                                            {
                                                <li>
                                                    <form asp-controller="Admin"
                                                          asp-action="MarkBookingPaid"
                                                          method="post">

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.BookingId" />

                                                        <button type="submit"
                                                                class="dropdown-item text-success"
                                                                onclick="return confirm('Mark this booking as paid?');">
                                                            <i class="bi bi-cash-coin me-2"></i>
                                                            Mark Paid
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            @if (booking.Status == "PendingPayment" && booking.PaymentStatus == "Paid")
                                            {
                                                <li>
                                                    <form asp-controller="Admin"
                                                          asp-action="ConfirmBooking"
                                                          method="post">

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.BookingId" />

                                                        <button type="submit"
                                                                class="dropdown-item text-success"
                                                                onclick="return confirm('Confirm this booking?');">
                                                            <i class="bi bi-check-circle me-2"></i>
                                                            Confirm Booking
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            @if (booking.Status == "Confirmed")
                                            {
                                                <li>
                                                    <form asp-controller="Admin"
                                                          asp-action="CompleteBooking"
                                                          method="post">

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.BookingId" />

                                                        <button type="submit"
                                                                class="dropdown-item text-primary"
                                                                onclick="return confirm('Mark this booking as completed?');">
                                                            <i class="bi bi-check2-all me-2"></i>
                                                            Mark Completed
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            @if (booking.Status != "Completed")
                                            {
                                                <li>
                                                    <form asp-controller="Admin"
                                                          asp-action="CancelBooking"
                                                          method="post">

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@booking.BookingId" />

                                                        <button type="submit"
                                                                class="dropdown-item text-danger"
                                                                onclick="return confirm('Cancel this booking?');">
                                                            <i class="bi bi-x-circle me-2"></i>
                                                            Cancel Booking
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(booking.PaymentReference))
                                            {
                                                <li><hr class="dropdown-divider"></li>

                                                <li>
                                                    <span class="dropdown-item-text small text-muted">
                                                        <strong>Payment Ref:</strong><br />
                                                        @booking.PaymentReference
                                                    </span>
                                                </li>
                                            }

                                        </ul>
                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>

        </div>

        @if (!bookings.Any())
        {
            <div class="alert alert-info mt-3">
                <i class="bi bi-info-circle me-2"></i>
                No bookings have been created yet.
            </div>
        }

    </div>
</section>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("bookingSearch");
            const statusFilter = document.getElementById("statusFilter");
            const paymentFilter = document.getElementById("paymentFilter");
            const travelerFilter = document.getElementById("travelerFilter");
            const clearFilters = document.getElementById("clearFilters");
            const rows = document.querySelectorAll(".booking-row");
            const visibleCount = document.getElementById("visibleBookingCount");

            function filterBookings() {

                const searchValue = searchInput.value.toLowerCase().trim();
                const statusValue = statusFilter.value;
                const paymentValue = paymentFilter.value;
                const travelerValue = travelerFilter.value;

                let visibleRows = 0;

                rows.forEach(row => {

                    const rowText = row.innerText.toLowerCase();

                    const status = row.dataset.status;
                    const payment = row.dataset.payment;
                    const travelers = parseInt(row.dataset.travelers || "0");

                    const matchesSearch =
                        searchValue === "" ||
                        rowText.includes(searchValue);

                    const matchesStatus =
                        statusValue === "" ||
                        status === statusValue;

                    const matchesPayment =
                        paymentValue === "" ||
                        payment === paymentValue;

                    let matchesTravelers = true;

                    if (travelerValue === "5+") {
                        matchesTravelers = travelers >= 5;
                    }
                    else if (travelerValue !== "") {
                        matchesTravelers =
                            travelers === parseInt(travelerValue);
                    }

                    const shouldShow =
                        matchesSearch &&
                        matchesStatus &&
                        matchesPayment &&
                        matchesTravelers;

                    row.style.display = shouldShow ? "" : "none";

                    if (shouldShow) {
                        visibleRows++;
                    }
                });

                visibleCount.textContent = visibleRows;
            }

            searchInput.addEventListener("input", filterBookings);
            statusFilter.addEventListener("change", filterBookings);
            paymentFilter.addEventListener("change", filterBookings);
            travelerFilter.addEventListener("change", filterBookings);

            clearFilters.addEventListener("click", function () {

                searchInput.value = "";
                statusFilter.value = "";
                paymentFilter.value = "";
                travelerFilter.value = "";

                filterBookings();
            });

        });
    </script>
}
