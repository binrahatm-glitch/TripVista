@model IEnumerable<TripVista.Models.Entities.Destinations>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Destination Review Queue</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>

    <div class="container mt-5">
        <h2 class="mb-4">Destination Review Queue</h2>

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @foreach (var dest in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@dest.Name</h5>
                    <p class="text-muted mb-1">@dest.Location</p>
                    <p class="small">@dest.Description</p>
                    <p class="small text-muted">Submitted by @(dest.SubmittedByUser?.FullName) on @dest.SubmittedAt.ToString("dd MMM yyyy")</p>

                    <div class="row g-2 mt-2">
                        <div class="col-md-8">
                            <form asp-controller="Admin" asp-action="ApproveDestination" method="post" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@dest.DestinationId" />
                                <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Remarks (optional)" />
                                <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                        </div>
                        <div class="col-md-4">
                            <form asp-controller="Admin" asp-action="RejectDestination" method="post" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@dest.DestinationId" />
                                <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Reason (required)" required />
                                <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">No pending destination submissions.</div>
        }

        <a asp-controller="Admin" asp-action="DestinationHistory" class="btn btn-outline-secondary">View History</a>
        <a asp-controller="Admin" asp-action="AdminDashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

</body>
</html>
