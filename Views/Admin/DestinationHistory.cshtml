@model IEnumerable<TripVista.Models.Entities.Destinations>
@{
    ViewData["Title"] = "Destination History";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">
    <div class="container position-relative">
        <h1>Destination History</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Admin" asp-action="AdminDashboard">Admin</a></li>
                <li class="current">Destination History</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        <div class="tv-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Submitted By</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th>Reviewed By</th>
                            <th>Reviewed On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dest in Model)
                        {
                            <tr>
                                <td>@dest.Name</td>
                                <td>@dest.SubmittedByUser?.FullName</td>
                                <td>
                                    @if (dest.Status == "Approved")
                                    {
                                        <span class="tv-badge bg-success text-white">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="tv-badge bg-danger text-white">Rejected</span>
                                    }
                                </td>
                                <td>@dest.AdminRemarks</td>
                                <td>@dest.ReviewedByAdmin?.FullName</td>
                                <td>@dest.ReviewedAt?.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <a asp-controller="Admin" asp-action="DestinationQueue" class="btn btn-outline-secondary">Back to Queue</a>
        </div>
    </div>
</section>
