@model IEnumerable<TripVista.Models.Entities.Destinations>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Destination History</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>

    <div class="container mt-5">
        <h2 class="mb-4">Destination History</h2>

        <table class="table table-bordered bg-white">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Submitted By</th>
                    <th>Status</th>
                    <th>Remarks</th>
                    <th>Reviewed By</th>
                    <th>Reviewed On</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dest in Model)
                {
                    <tr>
                        <td>@dest.Name</td>
                        <td>@dest.SubmittedByUser?.FullName</td>
                        <td>
                            @if (dest.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>@dest.AdminRemarks</td>
                        <td>@dest.ReviewedByAdmin?.FullName</td>
                        <td>@dest.ReviewedAt?.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>

        <a asp-controller="Admin" asp-action="DestinationQueue" class="btn btn-outline-secondary">Back to Queue</a>
        <a asp-controller="Admin" asp-action="AdminDashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

</body>
</html>
