@model TripVista.Models.DTO.PackageFormViewModel
@{
    ViewData["Title"] = "Edit Package";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-7.webp")');">
    <div class="container position-relative">
        <h1>Edit Package</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Admin" asp-action="Packages">Packages</a></li>
                <li class="current">Edit Package</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="tv-card">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <form asp-action="EditPackage" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="PackageId" />
                        <input type="hidden" asp-for="ImagePath" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Details" class="form-label">Description</label>
                            <textarea asp-for="Details" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Package Image</label>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <img src="@Model.ImagePath" alt="Current image" class="d-block mb-2 rounded" style="max-height: 120px;" />
                            }
                            <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" />
                            <div class="form-text">Leave empty to keep the current image.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Region" class="form-label"></label>
                            <select asp-for="Region" class="form-select">
                                <option value="">Select a region</option>
                                <option value="Northern">Northern Areas</option>
                                <option value="Coastal">Coastal</option>
                                <option value="Urban">Urban</option>
                                <option value="Desert">Desert</option>
                            </select>
                            <span asp-validation-for="Region" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="PricePerPerson" class="form-label"></label>
                                <input asp-for="PricePerPerson" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="PricePerPerson" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Duration (days)</label>
                                <input type="text" id="durationDisplay" class="form-control" readonly value="@Model.DurationDays" />
                                <div class="form-text">Calculated automatically from the tour dates.</div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxGroupSize" class="form-label"></label>
                                <input asp-for="MaxGroupSize" type="number" class="form-control" />
                                <span asp-validation-for="MaxGroupSize" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="TourStartDate" class="form-label"></label>
                                <input asp-for="TourStartDate" type="date" class="form-control" id="tourStartDate" />
                                <span asp-validation-for="TourStartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TourEndDate" class="form-label"></label>
                                <input asp-for="TourEndDate" type="date" class="form-control" id="tourEndDate" />
                                <span asp-validation-for="TourEndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Active (visible to users)</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Destinations Visited</label>
                            <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                                @if (!Model.DestinationOptions.Any())
                                {
                                    <p class="text-muted small mb-0">No approved destinations yet.</p>
                                }
                                @for (int i = 0; i < Model.DestinationOptions.Count; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" asp-for="DestinationOptions[i].DestinationId" />
                                        <input type="hidden" asp-for="DestinationOptions[i].Name" />
                                        <input type="checkbox" asp-for="DestinationOptions[i].Selected" class="form-check-input" />
                                        <label class="form-check-label">@Model.DestinationOptions[i].Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-controller="Admin" asp-action="Packages" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const startInput = document.getElementById("tourStartDate");
        const endInput = document.getElementById("tourEndDate");
        const durationDisplay = document.getElementById("durationDisplay");
        const today = new Date().toISOString().split("T")[0];
        startInput.min = today;

        function updateDuration() {
            endInput.min = startInput.value || today;

            if (startInput.value && endInput.value) {
                const diffDays = Math.round((new Date(endInput.value) - new Date(startInput.value)) / 86400000);
                durationDisplay.value = diffDays >= 0 ? diffDays : 0;
            } else {
                durationDisplay.value = 0;
            }
        }

        startInput.addEventListener("change", updateDuration);
        endInput.addEventListener("change", updateDuration);
        updateDuration();
    </script>
}
