@model TripVista.Models.DTO.AdminDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Admin Dashboard";

    var statusLabelMap = new Dictionary<string, string>
    {
        ["PendingPayment"] = "Pending Payment",
        ["Confirmed"] = "Confirmed",
        ["Completed"] = "Completed",
        ["Cancelled"] = "Cancelled"
    };
    var statusColorMap = new Dictionary<string, string>
    {
        ["PendingPayment"] = "#fab219",
        ["Confirmed"] = "#0ca30c",
        ["Completed"] = "#2a78d6",
        ["Cancelled"] = "#d03b3b"
    };

    var statusLabels = Model.BookingStatusCounts.Select(s => statusLabelMap.GetValueOrDefault(s.Status, s.Status)).ToList();
    var statusData = Model.BookingStatusCounts.Select(s => s.Count).ToList();
    var statusColors = Model.BookingStatusCounts.Select(s => statusColorMap.GetValueOrDefault(s.Status, "#898781")).ToList();

    var monthLabels = Model.RevenueByMonth.Select(m => m.MonthLabel).ToList();
    var monthRevenue = Model.RevenueByMonth.Select(m => m.Revenue).ToList();

    var topPackageLabels = Model.TopPackages.Select(p => p.Title).ToList();
    var topPackageCounts = Model.TopPackages.Select(p => p.Count).ToList();

    var jsonOptions = new JsonSerializerOptions();
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>Hello, @Context.Session.GetString("name")</h1>
        <p>Welcome to the admin dashboard.</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Admin Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-success">@TempData["msg"]</div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="section-subtitle mb-0">Overview</h3>
            <form asp-controller="Admin" asp-action="RetrainAiModels" method="post">
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-robot me-1"></i>Retrain AI Models
                </button>
            </form>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="tv-card h-100 py-3 px-3 text-center">
                    <div class="small text-muted mb-1">Total Revenue</div>
                    <div class="fs-4 fw-bold" style="color: var(--accent-color);">PKR @Model.TotalRevenue.ToString("N0")</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="tv-card h-100 py-3 px-3 text-center">
                    <div class="small text-muted mb-1">Total Bookings</div>
                    <div class="fs-4 fw-bold">@Model.TotalBookings</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="tv-card h-100 py-3 px-3 text-center">
                    <div class="small text-muted mb-1">Active Packages</div>
                    <div class="fs-4 fw-bold">@Model.ActivePackagesCount</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="tv-card h-100 py-3 px-3 text-center">
                    <div class="small text-muted mb-1">Registered Users</div>
                    <div class="fs-4 fw-bold">@Model.TotalUsersCount</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="tv-card h-100 py-3 px-3 text-center">
                    <div class="small text-muted mb-1">Pending Destinations</div>
                    <div class="fs-4 fw-bold">@Model.PendingDestinationsCount</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-lg-4">
                <div class="tv-card h-100">
                    <h6 class="fw-semibold mb-3">Bookings by Status</h6>
                    <div style="height: 260px;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="tv-card h-100">
                    <h6 class="fw-semibold mb-3">Revenue &ndash; Last 6 Months</h6>
                    <div style="height: 260px;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="tv-card h-100">
                    <h6 class="fw-semibold mb-3">Top Packages by Bookings</h6>
                    <div style="height: 260px;">
                        @if (topPackageLabels.Any())
                        {
                            <canvas id="topPackagesChart"></canvas>
                        }
                        else
                        {
                            <p class="text-muted small">No booking activity yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <h3 class="section-subtitle mb-3">Quick Actions</h3>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="Packages" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-suitcase-fill me-2" style="color: var(--accent-color);"></i>Manage Packages</h5>
                        <p class="text-muted mb-0">Create, edit, deactivate, or delete travel packages.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="ManageDestinations" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-color);"></i>Manage Destinations</h5>
                        <p class="text-muted mb-0">Publish new destinations and review past submissions.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="DestinationQueue" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-inbox-fill me-2" style="color: var(--accent-color);"></i>Destination Review Queue</h5>
                        <p class="text-muted mb-0">Approve or reject user-submitted destinations.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Poll" asp-action="ManagePolls" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-bar-chart-fill me-2" style="color: var(--accent-color);"></i>Manage Polls</h5>
                        <p class="text-muted mb-0">Create, close, or delete community polls.</p>
                    </div>
                </a>
            </div>
        </div>

        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger mt-4">Logout</a>
    </div>
</section>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        const mutedInk = "#898781";
        const gridline = "#e1e0d9";
        const baselineAxis = "#c3c2b7";

        Chart.defaults.font.family = "'Roboto', sans-serif";
        Chart.defaults.color = mutedInk;

        const commonScales = {
            x: { grid: { display: false }, border: { color: baselineAxis }, ticks: { color: mutedInk } },
            y: {
                beginAtZero: true,
                grid: { color: gridline },
                border: { display: false },
                ticks: { color: mutedInk, precision: 0 }
            }
        };

        new Chart(document.getElementById("statusChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(statusLabels, jsonOptions)),
                datasets: [{
                    data: @Html.Raw(JsonSerializer.Serialize(statusData, jsonOptions)),
                    backgroundColor: @Html.Raw(JsonSerializer.Serialize(statusColors, jsonOptions)),
                    borderRadius: 4,
                    maxBarThickness: 40
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: commonScales
            }
        });

        new Chart(document.getElementById("revenueChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(monthLabels, jsonOptions)),
                datasets: [{
                    label: "Revenue (PKR)",
                    data: @Html.Raw(JsonSerializer.Serialize(monthRevenue, jsonOptions)),
                    backgroundColor: "#008cad",
                    borderRadius: 4,
                    maxBarThickness: 40
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: commonScales
            }
        });

        @if (topPackageLabels.Any())
        {
            <text>
            new Chart(document.getElementById("topPackagesChart"), {
                type: "bar",
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(topPackageLabels, jsonOptions)),
                    datasets: [{
                        label: "Bookings",
                        data: @Html.Raw(JsonSerializer.Serialize(topPackageCounts, jsonOptions)),
                        backgroundColor: "#008cad",
                        borderRadius: 4,
                        maxBarThickness: 28
                    }]
                },
                options: {
                    indexAxis: "y",
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: gridline }, border: { display: false }, ticks: { color: mutedInk, precision: 0 } },
                        y: { grid: { display: false }, border: { color: baselineAxis }, ticks: { color: mutedInk } }
                    }
                }
            });
            </text>
        }
    </script>
}
