@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>

    <div class="container mt-5">
        <h2>Hello, @Context.Session.GetString("name")</h2>
        <p class="text-muted">Welcome to the admin dashboard.</p>

        <div class="list-group mt-4 col-md-5">
            <a asp-controller="Admin" asp-action="Packages" class="list-group-item list-group-item-action">Manage Packages</a>
            <a asp-controller="Admin" asp-action="CreateDestination" class="list-group-item list-group-item-action">Create Destination</a>
            <a asp-controller="Admin" asp-action="DestinationQueue" class="list-group-item list-group-item-action">Destination Review Queue</a>
            <a asp-controller="Admin" asp-action="DestinationHistory" class="list-group-item list-group-item-action">Destination History</a>
            <a asp-controller="Poll" asp-action="ManagePolls" class="list-group-item list-group-item-action">Manage Polls</a>
        </div>

        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger mt-4">Logout</a>
    </div>

</body>
</html>
