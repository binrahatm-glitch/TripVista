@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>Hello, @Context.Session.GetString("name")</h1>
        <p>Welcome to the admin dashboard.</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Admin Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="Packages" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-suitcase-fill me-2" style="color: var(--accent-color);"></i>Manage Packages</h5>
                        <p class="text-muted mb-0">Create, edit, deactivate, or delete travel packages.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="CreateDestination" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-color);"></i>Create Destination</h5>
                        <p class="text-muted mb-0">Directly publish a new destination.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="DestinationQueue" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-inbox-fill me-2" style="color: var(--accent-color);"></i>Destination Review Queue</h5>
                        <p class="text-muted mb-0">Approve or reject user-submitted destinations.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="DestinationHistory" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-clock-history me-2" style="color: var(--accent-color);"></i>Destination History</h5>
                        <p class="text-muted mb-0">See all previously reviewed submissions.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Poll" asp-action="ManagePolls" class="text-decoration-none">
                    <div class="tv-card h-100">
                        <h5><i class="bi bi-bar-chart-fill me-2" style="color: var(--accent-color);"></i>Manage Polls</h5>
                        <p class="text-muted mb-0">Create, close, or delete community polls.</p>
                    </div>
                </a>
            </div>
        </div>

        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger mt-4">Logout</a>
    </div>
</section>
