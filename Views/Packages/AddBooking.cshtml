@model TripVista.Models.DTO.AddBookingViewModel
@{
    ViewData["Title"] = "Book Package";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">
    <div class="container position-relative">
        <h1>Book Package</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="User" asp-action="UserDashboard">Packages</a></li>
                <li class="current">Book Package</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-6">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" asp-validation-summary="All"></div>
                }

                <div class="tv-card">
                    <form asp-action="AddBooking" method="post">
                        <input type="hidden" asp-for="PackageId" />
                        <input type="hidden" asp-for="PricePerPerson" />
                        <input type="hidden" asp-for="MaxGroupSize" />

                        <div class="mb-3">
                            <label class="form-label">Package</label>
                            <input class="form-control" value="@Model.PackageTitle" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NumberOfTravelers" class="form-label">Number of Travelers</label>
                            <input asp-for="NumberOfTravelers" class="form-control" min="1" max="@Model.MaxGroupSize" id="numTravelers" />
                            <span asp-validation-for="NumberOfTravelers" class="text-danger"></span>
                            <div class="form-text">Maximum group size for this package: @Model.MaxGroupSize</div>
                        </div>

                        <div class="alert alert-info">
                            <strong>Price per person:</strong> PKR @Model.PricePerPerson <br />
                            <strong>Total Price:</strong> PKR <span id="totalPrice">@(Model.PricePerPerson * Model.NumberOfTravelers)</span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Confirm Booking
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const pricePerPerson = @Model.PricePerPerson;
        const numInput = document.getElementById("numTravelers");
        const totalDisplay = document.getElementById("totalPrice");

        numInput.addEventListener("input", function () {
            const n = parseInt(numInput.value) || 0;
            totalDisplay.textContent = (pricePerPerson * n).toFixed(2);
        });
    </script>
}
