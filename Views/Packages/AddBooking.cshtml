@model TripVista.Models.DTO.AddBookingViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Create Booking</title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

</head>
<body>

    <h2 class="mb-4">Book Package</h2>

    <div class="card shadow p-4">
        <form asp-action="AddBooking" method="post">
            <input type="hidden" asp-for="PackageId" />
            <input type="hidden" asp-for="Price" />
            <input type="hidden" asp-for="Discount" />
            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label class="form-label">Package</label>
                <input class="form-control" value="@Model.PackageTitle" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" disabled />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" disabled />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumberOfPersons" class="form-label"></label>
                <input asp-for="NumberOfPersons" class="form-control" min="1" />
            </div>

            <div class="mb-3">
                <label asp-for="TravelDate" class="form-label"></label>
                <input asp-for="TravelDate" type="date" class="form-control" />
            </div>

            <div class="alert alert-info">
                <strong>Price:</strong> @Model.Price <br />
                <strong>Discount:</strong> @Model.Discount
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Confirm Booking
            </button>
        </form>
    </div>

</body>
</html>
