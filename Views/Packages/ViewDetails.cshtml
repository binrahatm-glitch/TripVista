@model TripVista.Models.Entities.Packages
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Details</title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

</head>
<body>

    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="row g-0">
                <div class="col-md-5">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" class="img-fluid rounded-start" alt="@Model.Title" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/500x300?text=No+Image" class="img-fluid rounded-start" />
                    }
                </div>

                <div class="col-md-7">
                    <div class="card-body">
                        <h3 class="card-title">@Model.Title</h3>

                        <p class="text-muted mb-1">
                            <strong>Duration:</strong> @Model.DurationDays days
                        </p>

                        <p class="text-muted mb-1">
                            <strong>Price per person:</strong> PKR @Model.PricePerPerson
                        </p>

                        <p class="text-muted mb-1">
                            <strong>Max Group Size:</strong> @Model.MaxGroupSize travelers
                        </p>

                        <p class="text-muted mb-3">
                            <strong>Tour Dates:</strong> @Model.TourStartDate.ToString("dd MMM yyyy") - @Model.TourEndDate.ToString("dd MMM yyyy")
                        </p>

                        @if (Model.PackageDestinations != null && Model.PackageDestinations.Any())
                        {
                            <p class="text-muted mb-1"><strong>Itinerary:</strong></p>
                            <ol class="mb-3">
                                @foreach (var stop in Model.PackageDestinations)
                                {
                                    <li>@stop.Destination?.Name</li>
                                }
                            </ol>
                        }

                        <p class="card-text">@Model.Details</p>

                        <p class="mt-3">
                            <strong>Status:</strong>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-primary">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </p>

                        <a asp-controller="User" asp-action="UserDashboard" class="btn btn-secondary mt-3">Back to Packages</a>
                        @if (Model.IsActive)
                        {
                            <a asp-action="AddBooking" asp-controller="Packages" asp-route-id="@Model.PackageId" class="btn btn-success mt-3">Book Now</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
