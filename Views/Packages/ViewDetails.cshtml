@model TripVista.Models.Entities.Packages
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Details</title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    
</head>
<body>

    <div class="container mt-5">
        <div class="card shadow-lg">
            <div class="row g-0">
                <div class="col-md-5">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" class="img-fluid rounded-start" alt="@Model.Title" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/500x300?text=No+Image" class="img-fluid rounded-start" />
                    }
                </div>

                <div class="col-md-7">
                    <div class="card-body">
                        <h3 class="card-title">@Model.Title</h3>

                        <p class="text-muted mb-1">
                            <strong>Duration:</strong> @Model.DurationDays days
                        </p>

                        <p class="text-muted mb-3">
                            <strong>Price:</strong> $@Model.Price
                            @if (Model.Discount > 0)
                            {
                                <span class="badge bg-success ms-2">@Model.Discount% Off</span>
                            }
                        </p>

                        <p class="card-text">@Model.Details</p>

                        <p class="mt-3">
                            <strong>Status:</strong>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-primary">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </p>

                        <p class="text-muted mt-2">
                            <small>Created at: @Model.CreatedAt.ToString("yyyy-MM-dd")</small>
                        </p>

                        <a href="/Packages/Index" class="btn btn-secondary mt-3">Back to Packages</a>
                        <a asp-action="AddBooking" asp-controller="Packages" asp-route-id="@Model.PackageId" class="btn btn-success mt-3">Book Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
