@model TripVista.Models.DTO.AddDestinationDTO

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Submit a Destination</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f8f9fa; }
    </style>
</head>
<body>
    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Submit a Destination</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="AddDestination" asp-controller="Destination" enctype="multipart/form-data">

                            <div class="mb-3">
                                <label class="form-label">Destination Name</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Location</label>
                                <input asp-for="Location" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Image (optional)</label>
                                <input type="file" asp-for="Image" class="form-control" />
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-success">Submit for Review</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
