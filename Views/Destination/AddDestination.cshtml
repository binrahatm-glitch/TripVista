@model TripVista.Models.DTO.AddDestinationDTO
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Add Destination</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>

    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Add New Destination</h4>
                    </div>

                    <div class="card-body">
                        <form method="post"
                              asp-action="AddDestination"
                              asp-controller="Destination"
                              enctype="multipart/form-data">

                            <!-- Name -->
                            <div class="mb-3">
                                <label class="form-label">Destination Name</label>
                                <input asp-for="Name" class="form-control" required />
                            </div>

                            <!-- Category & Location -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Category</label>
                                    <input asp-for="Category" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Location</label>
                                    <input asp-for="Location" class="form-control" />
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>

                            <!-- Image -->
                            <div class="mb-3">
                                <label class="form-label">Destination Image</label>
                                <input type="file" asp-for="Image" class="form-control" />
                            </div>

                            <!-- Best Time -->
                            <div class="mb-3">
                                <label class="form-label">Best Time To Visit</label>
                                <input asp-for="BestTimeToVisit" class="form-control" />
                            </div>

                            <!-- Latitude & Longitude -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Latitude</label>
                                    <input asp-for="Latitude" type="number" step="any" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Longitude</label>
                                    <input asp-for="Longitude" type="number" step="any" class="form-control" />
                                </div>
                            </div>

                            <!-- Cost -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <label class="form-label">Average Cost (Min)</label>
                                    <input asp-for="AverageCostMin" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Average Cost (Max)</label>
                                    <input asp-for="AverageCostMax" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>

                            <!-- Submit -->
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success">
                                    Save Destination
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
