@model TripVista.Models.DTO.AddDestinationDTO
@{
    ViewData["Title"] = "Submit a Destination";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">
    <div class="container position-relative">
        <h1>Submit a Destination</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Destination" asp-action="Destinations">Destinations</a></li>
                <li class="current">Submit a Destination</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="tv-card">
                    <form method="post" asp-action="AddDestination" asp-controller="Destination" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label">Destination Name</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Image (optional)</label>
                            <input type="file" asp-for="Image" class="form-control" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Submit for Review</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
