@model IEnumerable<TripVista.Models.Entities.Destinations>

@{
    ViewData["Title"] = "Destinations";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-8.webp")');">
    <div class="container position-relative">
        <h1>Destinations</h1>
        <p>Explore destinations submitted and approved by the TripVista community.</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Destinations</li>
            </ol>
        </nav>
    </div>
</div>

<section id="travel-destinations" class="travel-destinations section">
    <div class="container" data-aos="fade-up">

        <div class="row mb-4">
            <div class="col-lg-8">
                <h3 class="section-subtitle">Explore Destinations</h3>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Destination" asp-action="AddDestination" class="btn btn-primary">Submit a Destination</a>
            </div>
        </div>

        <div class="row gy-4 isotope-container">
            @foreach (var dest in Model)
            {
                <div class="col-lg-4 col-md-6 destination-item">
                    <a asp-controller="Destination" asp-action="ViewDetails" asp-route-id="@dest.DestinationId" class="destination-tile">
                        <div class="tile-image">
                            @if (!string.IsNullOrEmpty(dest.ImageUrl))
                            {
                                <img src="@dest.ImageUrl" alt="@dest.Name" class="img-fluid" loading="lazy">
                            }
                            else
                            {
                                <img src="@Url.Content("~/theme/assets/img/travel/destination-2.webp")" alt="@dest.Name" class="img-fluid" loading="lazy">
                            }
                            <div class="overlay-content">
                                <div class="destination-info">
                                    <h4>@dest.Name</h4>
                                    <p>@dest.Location</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">No approved destinations yet.</div>
        }

    </div>
</section>
