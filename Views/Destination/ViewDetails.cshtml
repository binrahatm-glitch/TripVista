@model TripVista.Models.Entities.Destinations
@{
    ViewData["Title"] = Model.Name;
    var heroImage = string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content("~/theme/assets/img/travel/destination-2.webp") : Model.ImageUrl;
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@heroImage');">
    <div class="container position-relative">
        <h1>@Model.Name</h1>
        <p>@Model.Location</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Destination" asp-action="Destinations">Destinations</a></li>
                <li class="current">@Model.Name</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="tv-card">
                    <p><strong>Location:</strong> @Model.Location</p>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <h5 class="mt-4">Description</h5>
                        <p>@Model.Description</p>
                    }

                    <div class="mt-4">
                        <a asp-controller="Destination" asp-action="Destinations" class="btn btn-outline-primary">Back to Destinations</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
