@model TripVista.Models.Entities.Destinations

@{
    ViewData["Title"] = "Submission Status";

    string statusClass = Model.Status switch
    {
        "Approved" => "success",
        "Rejected" => "danger",
        _ => "warning"
    };

    string statusIcon = Model.Status switch
    {
        "Approved" => "✅",
        "Rejected" => "❌",
        _ => "⏳"
    };
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>Submission Status</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Destination" asp-action="MySubmissions">My Submissions</a></li>
                <li class="current">Status</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="tv-card text-center">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" style="height:220px; width:100%; object-fit:cover;" />
                    }

                    <div class="mb-2" style="font-size: 3rem;">@statusIcon</div>
                    <h4 class="fw-bold text-@statusClass mb-3">Submission @Model.Status</h4>

                    @if (Model.Status == "Pending")
                    {
                        <p class="text-muted">Your submission has been successfully sent and is currently <strong>under review</strong> by our admin team.</p>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <p class="text-success">Congratulations! Your submission has been approved 🎉</p>
                    }
                    else
                    {
                        <p class="text-danger">Unfortunately, your submission was rejected.</p>
                    }

                    <hr />

                    <div class="text-start small">
                        <p><strong>Name:</strong> @Model.Name</p>
                        <p><strong>Location:</strong> @Model.Location</p>
                        <p><strong>Submitted On:</strong> @Model.SubmittedAt.ToPakistanTime().ToString("dd MMM yyyy")</p>

                        @if (Model.ReviewedAt != null)
                        {
                            <p><strong>Reviewed On:</strong> @Model.ReviewedAt.Value.ToPakistanTime().ToString("dd MMM yyyy")</p>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                    {
                        <div class="alert alert-secondary text-start mt-3">
                            <strong>Admin Remarks:</strong><br />
                            @Model.AdminRemarks
                        </div>
                    }

                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="User" asp-action="UserDashboard" class="btn btn-primary">Back to Home</a>
                        <a asp-controller="Destination" asp-action="AddDestination" class="btn btn-outline-secondary">Submit Another Destination</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
