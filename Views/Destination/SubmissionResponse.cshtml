@model TripVista.Models.Entities.UserSubmissions

@{
    Layout = null;

    string statusClass = Model.Status switch
    {
        "Approved" => "success",
        "Rejected" => "danger",
        _ => "warning"
    };

    string statusIcon = Model.Status switch
    {
        "Approved" => "✅",
        "Rejected" => "❌",
        _ => "⏳"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Submission Status</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f4f6f9;
        }

        .status-card {
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
        }

        .status-icon {
            font-size: 3rem;
        }
    </style>
</head>

<body>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">

        <div class="col-md-8 col-lg-6">

            <div class="card status-card">

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath"
                         class="card-img-top"
                         style="height:220px; object-fit:cover;" />
                }

                <div class="card-body text-center p-4">

                    <!-- STATUS ICON -->
                    <div class="status-icon mb-2">
                        @statusIcon
                    </div>

                    <!-- STATUS -->
                    <h4 class="fw-bold text-@statusClass mb-3">
                        Submission @Model.Status
                    </h4>

                    <!-- MESSAGE -->
                    @if (Model.Status == "Pending")
                    {
                        <p class="text-muted">
                            Your submission has been successfully sent and is currently
                            <strong>under review</strong> by our admin team.
                        </p>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <p class="text-success">
                            Congratulations! Your submission has been approved 🎉
                        </p>
                    }
                    else
                    {
                        <p class="text-danger">
                            Unfortunately, your submission was rejected.
                        </p>
                    }

                    <hr />

                    <!-- DETAILS -->
                    <div class="text-start small">
                        <p><strong>Name:</strong> @Model.Name</p>
                        <p><strong>Category:</strong> @Model.Category</p>
                        <p><strong>Location:</strong> @Model.Location</p>
                        <p><strong>Submitted On:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>

                        @if (Model.ApprovedAt != null)
                        {
                            <p>
                                <strong>Reviewed On:</strong>
                                @Model.ApprovedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                            </p>
                        }
                    </div>

                    <!-- ADMIN COMMENT -->
                    @if (!string.IsNullOrEmpty(Model.AdminComment))
                    {
                        <div class="alert alert-secondary text-start mt-3">
                            <strong>Admin Comment:</strong><br />
                            @Model.AdminComment
                        </div>
                    }

                    <!-- ACTIONS -->
                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="User"
                           asp-action="UserDashboard"
                           class="btn btn-primary">
                            Back to Home
                        </a>

                        <a asp-controller="Destination"
                           asp-action="AddDestination"
                           class="btn btn-outline-secondary">
                            Submit Another Destination
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

</body>
</html>
