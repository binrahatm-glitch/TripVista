@model IEnumerable<TripVista.Models.Entities.Destinations>

@{
    ViewData["Title"] = "My Submissions";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-7.webp")');">
    <div class="container position-relative">
        <h1>My Submissions</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Destination" asp-action="Destinations">Destinations</a></li>
                <li class="current">My Submissions</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">

        <div class="row">
            @foreach (var submission in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="tv-card h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-semibold mb-0">@submission.Name</h5>
                            <span class="tv-badge @(submission.Status == "Approved" ? "bg-success text-white" : submission.Status == "Rejected" ? "bg-danger text-white" : "bg-warning text-dark")">
                                @submission.Status
                            </span>
                        </div>
                        <p class="text-muted small mb-1">@submission.Location</p>
                        <p class="small text-secondary mb-2">@submission.Description</p>

                        @if (!string.IsNullOrEmpty(submission.AdminRemarks))
                        {
                            <div class="alert alert-light border small mb-2">
                                <strong>Admin Remarks:</strong><br />
                                @submission.AdminRemarks
                            </div>
                        }

                        <p class="small text-muted mb-0">Submitted on: @submission.SubmittedAt.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">You have not submitted any destinations yet.</div>
        }

    </div>
</section>
