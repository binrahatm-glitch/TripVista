@model TripVista.Models.DTO.TripBudgetRequest
@{
    Layout = null;
    var userName = Context.Session.GetString("name");
    var result = ViewBag.Result as TripVista.Models.DTO.TripBudgetResult;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Plan My Trip</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="User" asp-action="UserDashboard">TripVista</a>
        </div>
    </nav>

    <div class="container py-4 col-md-7">
        <h3 class="fw-bold mb-4">Plan My Trip - Budget Estimator</h3>

        <form asp-action="PlanTrip" method="post" class="card p-4 mb-4">
            <div class="mb-3">
                <label asp-for="Budget" class="form-label">Total Budget (PKR)</label>
                <input asp-for="Budget" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="DurationDays" class="form-label">Duration (days)</label>
                    <input asp-for="DurationDays" type="number" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="NumberOfTravelers" class="form-label">Number of Travelers</label>
                    <input asp-for="NumberOfTravelers" type="number" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="PreferredRegion" class="form-label">Preferred Region (optional)</label>
                <select asp-for="PreferredRegion" class="form-select">
                    <option value="">No preference</option>
                    <option value="Northern">Northern Areas</option>
                    <option value="Coastal">Coastal</option>
                    <option value="Urban">Urban</option>
                    <option value="Desert">Desert</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Get Suggestion</button>
        </form>

        @if (result != null)
        {
            <div class="card p-4">
                <h5>Suggested Plan</h5>
                <p><strong>Daily budget per person:</strong> PKR @result.DailyBudgetPerPerson</p>
                <p><strong>Tier:</strong> @result.Tier</p>
                <p><strong>Suggested Region Style:</strong> @result.SuggestedRegion</p>

                <p class="mb-1"><strong>Suggested breakdown:</strong></p>
                <ul>
                    <li>Travel: @result.TravelPercent%</li>
                    <li>Accommodation: @result.AccommodationPercent%</li>
                    <li>Food: @result.FoodPercent%</li>
                    <li>Activities: @result.ActivitiesPercent%</li>
                </ul>

                <p class="text-muted">@result.Recommendation</p>
            </div>
        }
    </div>
</body>
</html>
