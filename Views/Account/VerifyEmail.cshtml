@model TripVista.Models.DTO.EmailVerifyViewModel
@{
    ViewData["Title"] = "Verify Email";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>Verify Email</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Verify Email</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="tv-card">
                    <h3 class="text-center mb-4">Verify Your Email</h3>

                    @if (TempData["msg"] != null)
                    {
                        <div class="alert alert-success">@TempData["msg"]</div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-warning">@TempData["Error"]</div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <p class="text-center">An OTP code was sent to <b>@Model.Email</b></p>

                    <form asp-action="VerifyEmail" asp-controller="Account" method="post">

                        <input asp-for="Email" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="OtpCode" class="form-label"></label>
                            <input asp-for="OtpCode" class="form-control" />
                            <span asp-validation-for="OtpCode" class="text-danger"></span>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">Verify</button>
                    </form>

                    <form asp-action="ResendOtp" asp-controller="Account" method="post" class="mt-2">
                        <input name="email" type="hidden" value="@Model.Email" />
                        <button class="btn btn-link w-100" type="submit">Resend OTP</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
