@model TripVista.Models.DTO.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-3.webp")');">
    <div class="container position-relative">
        <h1>Login</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Login</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="tv-card">
                    <h3 class="text-center mb-4">Welcome Back</h3>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" type="password" required />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div class="text-end mt-1">
                                <a asp-action="ForgotPassword" class="small">Forgot password?</a>
                            </div>
                        </div>

                        <button class="btn btn-primary w-100">Login</button>

                        <div class="mt-3 text-center">
                            <a asp-action="Register">Create an account</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
