@model TripVista.Models.DTO.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="page-title dark-background" data-aos="fade" style="background-image: url('@Url.Content("~/theme/assets/img/travel/showcase-9.webp")');">
    <div class="container position-relative">
        <h1>Reset Password</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Reset Password</li>
            </ol>
        </nav>
    </div>
</div>

<section class="tv-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="tv-card">
                    <h3 class="text-center mb-4">Enter Code & New Password</h3>

                    @if (TempData["msg"] != null)
                    {
                        <div class="alert alert-success">@TempData["msg"]</div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-warning">@TempData["Error"]</div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <p class="text-center">A reset code was sent to <b>@Model.Email</b> if that email is registered.</p>

                    <form asp-action="ResetPassword" method="post">
                        <input asp-for="Email" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="OtpCode" class="form-label">Reset Code</label>
                            <input asp-for="OtpCode" class="form-control" />
                            <span asp-validation-for="OtpCode" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">New Password</label>
                            <input asp-for="NewPassword" class="form-control" type="password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">Reset Password</button>
                    </form>

                    <form asp-action="ResendResetOtp" method="post" class="mt-2">
                        <input name="email" type="hidden" value="@Model.Email" />
                        <button class="btn btn-link w-100" type="submit">Resend Code</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
